# Public site URL used for canonical links, sitemap, Open Graph and JSON-LD.
# Set this to the final domain (e.g. https://raahi.pk). Falls back to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=https://travel-business-website-2.vercel.app

# Optional. When set, the inquiry server action forwards validated leads to this HTTPS endpoint
# (e.g. a Google Sheets webhook, Zapier/Make hook or CRM). Leave empty to run the site without a backend;
# leads then rely on the prefilled WhatsApp handoff shown to the visitor.
INQUIRY_WEBHOOK_URL=
