# Canonical production origin, the single source of truth for canonical links, sitemap, robots,
# Open Graph, Twitter and JSON-LD URLs. Set it in Vercel (Production) to the final domain with no
# trailing slash, e.g. https://raahi.pk. When unset: Vercel production uses the project URL,
# preview deployments use their own URL (and are marked noindex), local development uses localhost.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Google Search Console HTML-tag verification token (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. When set, the lead server action forwards validated leads to this HTTPS endpoint
# (e.g. a Google Sheets webhook, Zapier/Make hook or CRM). Leave empty to run without a backend;
# visitors still get a reference number and a prefilled WhatsApp handoff.
INQUIRY_WEBHOOK_URL=
